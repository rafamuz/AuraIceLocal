<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\rm-aura-ice-app.ico</ApplicationIcon>
    <AssemblyName>RMAuraIceDisplay</AssemblyName>
    <RootNamespace>AuraIceLocal</RootNamespace>
    <Product>RM Aura Ice Display</Product>
    <AssemblyTitle>RM Aura Ice Display</AssemblyTitle>
    <Description>Monitor local para o visor Rise Mode Aura Ice</Description>
    <Version>0.3.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\device-profiles.json" Link="device-profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\docs\MANUAL_DO_USUARIO.md" Link="MANUAL_DO_USUARIO.md" LogicalName="AuraIceLocal.ManualDoUsuario.md" />
    <EmbeddedResource Include="..\..\assets\rm-aura-ice-app-icon.png" Link="assets\rm-aura-ice-app-icon.png" LogicalName="AuraIceLocal.AppIcon.png" />
    <EmbeddedResource Include="..\..\assets\rm-aura-ice-app.ico" Link="assets\rm-aura-ice-app.ico" LogicalName="AuraIceLocal.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
